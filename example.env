# example.env — copy this file to `.env` and fill in your real values.
# `.env` is gitignored and must NEVER be committed or shared.

# Your Gemini API key (used through the OpenAI-compatible endpoint).
# Get one at https://aistudio.google.com/apikey — key stays only in .env.
OPENAI_API_KEY=paste-your-gemini-key-here

# Model pinned at the head of the failover catalog (desk/model_config.py).
# gemini-2.5-flash was retired by the provider for this project's key;
# gemini-3.6-flash is the verified working head.
GEMINI_MODEL=gemini-3.6-flash

# Optional: comma-separated model ids to reorder the catalog head.
# MODEL_PRIORITY=gemini-3.6-flash,gemini-3.5-flash-lite
